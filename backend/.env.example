# Database
# Local dev (SQLite):
# DATABASE_URL="sqlite:///./logger.db"
# Production (Neon PostgreSQL — set on Render, NOT committed):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.sa-east-1.aws.neon.tech/DBNAME?sslmode=require"

# API Keys (copy backend/.env locally with your real values)
TMDB_API_KEY="your_tmdb_api_key_here"
IGDB_CLIENT_ID="your_igdb_client_id_here"
IGDB_CLIENT_SECRET="your_igdb_client_secret_here"
GOOGLE_BOOKS_API_KEY="your_google_books_api_key_here"
STEAM_API_KEY="your_steam_api_key_here"

# Dev only: username 'bruna' logs in with empty password
# DEV_BYPASS_LOGIN=true

# Admin bootstrap password (only used when the admin user doesn't exist yet)
# ADMIN_PASSWORD="change_me"
